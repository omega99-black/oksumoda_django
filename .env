# .env — equivalente a src/main/resources/application.properties
# Copia este archivo como .env y ajusta los valores

# ── Seguridad ──────────────────────────────────────────────────────────────
# Genera una clave segura con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-cambia-esto-en-produccion

DEBUG=True

# Hosts permitidos (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Base de datos (equivalente a spring.datasource.*) ─────────────────────
DB_NAME=prueba_oksu
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
